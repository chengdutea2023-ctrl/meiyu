{
  "name": "jiaoxue-platform",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "platform/*",
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace @jiaoxue/platform-api",
    "local:init": "node scripts/local-init.mjs",
    "local:infra": "node scripts/local-infra.mjs",
    "local:start": "node scripts/local-start.mjs",
    "local:verify": "node scripts/local-acceptance.cjs",
    "local:adapt-snapshot": "node scripts/local-adapt-snapshot.cjs",
    "coursewares:sync": "node scripts/courseware-sync.mjs",
    "dev:admin": "npm run dev --workspace @jiaoxue/admin-web",
    "dev:demo": "npm run start --workspace @jiaoxue/teaching-demo-app",
    "dev:mandarin": "npm run start --workspace @jiaoxue/mandarin-practice-app",
    "build": "npm run build --workspaces --if-present && npm run coursewares:qiong:build",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @jiaoxue/platform-api",
    "db:migrate": "npm run db:migrate --workspace @jiaoxue/platform-api",
    "db:deploy": "npm run db:deploy --workspace @jiaoxue/platform-api",
    "db:seed": "npm run db:seed --workspace @jiaoxue/platform-api",
    "agent:doctor": "node scripts/agent-doctor.mjs",
    "agent:check": "npm run prisma:generate && npm run lint && npm run build && npm run health:test && npm run coursewares:test && npm run coursewares:validate && npm run secrets:scan",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "health:test": "node --test scripts/health-service.test.mjs",
    "coursewares:validate": "node scripts/courseware-release.mjs --validate-only && node scripts/courseware-release.mjs --catalog coursewares/incoming-birds.json --validate-only && node scripts/courseware-release.mjs --catalog coursewares/incoming-qiong.json --validate-only",
    "coursewares:birds:package": "node scripts/courseware-release.mjs --catalog coursewares/incoming-birds.json",
    "coursewares:package": "node scripts/courseware-release.mjs",
    "coursewares:test": "node --test scripts/courseware-release.test.mjs scripts/baseline-tools.test.mjs scripts/bird-courseware.test.mjs scripts/yolo-controls.test.mjs scripts/icp-footer.test.cjs scripts/qiong-workflows.test.mjs scripts/launch-record-recovery.test.mjs && npm run coursewares:qiong:test",
    "coursewares:kiln:build": "node --check coursewares/qiong-kiln-challenge/static/app.js && node --check coursewares/qiong-kiln-challenge/static/engine.js && node --check coursewares/qiong-kiln-challenge/static/platform-client.js",
    "coursewares:kiln:test": "node --test coursewares/qiong-kiln-challenge/tests/*.test.cjs",
    "coursewares:kiln:package": "python3 coursewares/qiong-kiln-challenge/tools/package.py output/qiong-kiln-release",
    "coursewares:vision:build": "npm run build --prefix coursewares/qiong-ai-vision-challenge",
    "coursewares:vision:test": "node --test coursewares/qiong-ai-vision-challenge/tests/*.test.mjs",
    "coursewares:vision:package": "python3 coursewares/qiong-ai-vision-challenge/scripts/package.py output/qiong-vision-release",
    "coursewares:qiong:build": "npm run coursewares:kiln:build && npm run coursewares:vision:build && npm run coursewares:restoration:build",
    "coursewares:qiong:test": "npm run coursewares:kiln:test && npm run coursewares:vision:test && npm run coursewares:restoration:test",
    "coursewares:qiong:package": "npm run coursewares:kiln:package && npm run coursewares:vision:package && npm run coursewares:restoration:package",
    "coursewares:restoration:build": "node coursewares/qiong-ai-restoration-challenge/tools/build.mjs",
    "coursewares:restoration:test": "node --test coursewares/qiong-ai-restoration-challenge/tests/*.test.mjs",
    "coursewares:restoration:package": "node scripts/courseware-release.mjs --catalog coursewares/incoming-qiong-restoration.json"
  },
  "overrides": {
    "@nestjs/common": "11.1.19",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.19",
    "@phosphor-icons/react": "^2.1.10",
    "@tensorflow/tfjs": "^4.22.0",
    "jpeg-js": "^0.4.4",
    "typescript": "^5.6.3",
    "fflate": "^0.8.3",
    "sharp": "^0.35.5"
  }
}
