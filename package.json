{
  "name": "jiaoxue-platform",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "platform/*",
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace @jiaoxue/platform-api",
    "local:init": "node scripts/local-init.mjs",
    "local:infra": "node scripts/local-infra.mjs",
    "local:start": "node scripts/local-start.mjs",
    "local:verify": "node scripts/local-acceptance.cjs",
    "local:adapt-snapshot": "node scripts/local-adapt-snapshot.cjs",
    "coursewares:sync": "node scripts/courseware-sync.mjs",
    "dev:admin": "npm run dev --workspace @jiaoxue/admin-web",
    "dev:demo": "npm run start --workspace @jiaoxue/teaching-demo-app",
    "dev:mandarin": "npm run start --workspace @jiaoxue/mandarin-practice-app",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @jiaoxue/platform-api",
    "db:migrate": "npm run db:migrate --workspace @jiaoxue/platform-api",
    "db:deploy": "npm run db:deploy --workspace @jiaoxue/platform-api",
    "db:seed": "npm run db:seed --workspace @jiaoxue/platform-api",
    "agent:doctor": "node scripts/agent-doctor.mjs",
    "agent:check": "npm run prisma:generate && npm run lint && npm run build && npm run health:test && npm run coursewares:test && npm run coursewares:validate && npm run secrets:scan",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "health:test": "node --test scripts/health-service.test.mjs",
    "coursewares:validate": "node scripts/courseware-release.mjs --validate-only && node scripts/courseware-release.mjs --catalog coursewares/incoming-birds.json --validate-only",
    "coursewares:birds:package": "node scripts/courseware-release.mjs --catalog coursewares/incoming-birds.json",
    "coursewares:package": "node scripts/courseware-release.mjs",
    "coursewares:test": "node --test scripts/courseware-release.test.mjs scripts/baseline-tools.test.mjs scripts/bird-courseware.test.mjs"
  },
  "overrides": {
    "@nestjs/common": "11.1.19",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.19",
    "typescript": "^5.6.3"
  }
}
